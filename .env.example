# copie para .env (na raiz do repositório); lido pelo docker compose e pelo Django (backend/config/settings.py)

# PostgreSQL
POSTGRES_DB=visitasus
POSTGRES_USER=visitasus
POSTGRES_PASSWORD=visitasus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# origem do frontend Angular (ng serve)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# opcionais (padrões em backend/config/settings.py)
# INSTANCES_DIR=/caminho/absoluto/para/instances   # padrão: backend/data/instances
# PLANEJAMENTO_PARALELO=true
# ALERTA_EXCESSO_MIN=30
# ALERTA_FRACAO_ATRASADOS=0.25
